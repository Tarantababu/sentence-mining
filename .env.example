# Copy to backend/.env or export before running scripts.

# sqlite:///./sentence_mining.db  (local)
# postgresql+psycopg://user:pass@host:5432/sentence_mining  (prod)
DATABASE_URL=sqlite:///./sentence_mining.db

# When true/1, first boot inserts a realistic sample session + study pack.
SEED_SAMPLE_DATA=true

# Optional. Empty → deterministic template cards; app never requires this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12

CORS_ORIGINS=http://localhost:5173
APP_ENV=local
